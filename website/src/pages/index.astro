---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="পবিত্র আল-কুরআন ও নামাজ শিক্ষা"
  description="কুরআনের সূরা পরিচিতি, তিলাওয়াত ও নামাজ শেখার জন্য বাংলা সহায়িকা।"
>
  <section class="hero">
    <h1>পবিত্র আল-কুরআন ও নামাজ শিক্ষা</h1>
    <p>কুরআন পাঠ, সূরা পরিচিতি এবং নামাজ শেখার জন্য একটি সহজ বাংলা প্ল্যাটফর্ম।</p>
  </section>
  <section class="panel">
    <h2>শুরু করুন</h2>
    <div class="cards">
      <a class="card" href="/quran/"><strong>আল-কুরআন</strong><p class="muted">সূরা তালিকা ও পরিচিতি দেখুন।</p></a>
      <a class="card" href="/quran/surah/al-fatihah/"><strong>সূরা আল-ফাতিহা</strong><p class="muted">প্রথম সূরার পরিচিতি পৃষ্ঠা দেখুন।</p></a>
    </div>
  </section>
  <p class="muted">এটি Astro ওয়েবসাইটের প্রাথমিক কাঠামো। মূল অ্যাপের ফিচার ও যাচাইকৃত কুরআন ডেটা পরবর্তী ধাপে সংযুক্ত করা হবে।</p>
</BaseLayout>
