---
const {
  title = 'পবিত্র আল-কুরআন ও নামাজ শিক্ষা',
  description = 'কুরআন পাঠ, সূরা পরিচিতি এবং নামাজ শিক্ষার বাংলা সহায়িকা।'
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
---
<!doctype html>
<html lang="bn" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b5d45" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">আল-কুরআন ও নামাজ শিক্ষা</a>
      <nav aria-label="প্রধান নেভিগেশন">
        <a href="/">হোম</a>
        <a href="/quran/">কুরআন</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>কুরআন ও নামাজ শেখার সহায়ক বাংলা প্ল্যাটফর্ম</footer>
  </body>
</html>
<style is:global>
  :root{font-family:system-ui,"Noto Sans Bengali",sans-serif;color:#1c2b25;background:#fbf8f0}
  *{box-sizing:border-box}
  body{margin:0;line-height:1.8;background-image:radial-gradient(circle at 1px 1px,rgba(184,145,58,.08) 1px,transparent 0);background-size:26px 26px}
  a{color:#0b5d45}
  .site-header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px max(18px,calc((100% - 1080px)/2));background:#073d2d;color:#fff;border-bottom:3px solid #b8913a}
  .site-header a{color:#fff;text-decoration:none}
  .brand{font-weight:700}
  nav{display:flex;gap:16px}
  main{max-width:1080px;margin:0 auto;padding:28px 18px 64px;min-height:70vh}
  footer{text-align:center;padding:20px;color:#5d6b64;border-top:1px solid #e4ddc9}
  .hero,.panel{background:#fff;border:1px solid #e4ddc9;border-radius:18px;padding:24px;margin-bottom:18px}
  .hero{background:linear-gradient(135deg,#073d2d,#0b5d45);color:#fff;border:2px solid #b8913a}
  .hero h1{font-size:clamp(1.7rem,4vw,2.6rem);line-height:1.4;margin:0 0 8px}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
  .card{display:block;padding:18px;background:#fff;border:1px solid #e4ddc9;border-radius:14px;text-decoration:none;color:#1c2b25}
  .card:hover{border-color:#b8913a}
  .muted{color:#5d6b64}
  .arabic{font-family:"Noto Naskh Arabic","Traditional Arabic",serif;font-size:2rem;direction:rtl;text-align:center;line-height:2.2}
  @media(max-width:560px){.site-header{align-items:flex-start;flex-direction:column}nav{gap:12px}}
</style>
