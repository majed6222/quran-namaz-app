---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import surahs from '../../../data/surahs.json';

export function getStaticPaths() {
  return surahs.map((surah) => ({ params: { slug: surah.slug }, props: { surah } }));
}
const { surah } = Astro.props;
const description = `সূরা ${surah.bengaliName} (${surah.transliteration})। ${surah.ayahCount} আয়াতের আরবি পাঠ ও বাংলা অনুবাদ।`;
const structuredData = {
  "@context": "https://schema.org", "@type": "Chapter",
  name: surah.transliteration, alternateName: [surah.bengaliName, surah.arabicName],
  position: surah.number, isPartOf: { "@type": "Book", name: "আল-কুরআন" },
  numberOfPages: surah.ayahCount
};
---
<BaseLayout title={`সূরা ${surah.bengaliName} (${surah.transliteration}) | আল-কুরআন`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <p><a href="/quran/">← ১১৪টি সূরার তালিকায় ফিরে যান</a></p>
  <section class="hero">
    <p>সূরা নম্বর {surah.number} · {surah.revelation} · {surah.ayahCount} আয়াত</p>
    <h1>{surah.bengaliName}</h1>
    <div class="arabic" lang="ar">{surah.arabicName}</div>
    <p>{surah.transliteration}</p>
  </section>
  <section class="reader-tools" aria-label="পাঠ নিয়ন্ত্রণ">
    <label for="translation">বাংলা অনুবাদ</label>
    <select id="translation"><option value="auto">স্বয়ংক্রিয়ভাবে নির্বাচন</option></select>
    <button id="load-reader" type="button">আয়াত লোড করুন</button>
    <button id="font-down" type="button" aria-label="আরবি লেখা ছোট করুন">A−</button>
    <button id="font-up" type="button" aria-label="আরবি লেখা বড় করুন">A+</button>
    <button id="toggle-tajweed" type="button" aria-pressed="false">তাজবিদের রং দেখান</button>
  </section>
  <section class="audio-player panel" aria-label="তিলাওয়াত অডিও প্লেয়ার">
    <h2>আয়াতভিত্তিক তিলাওয়াত</h2>
    <label for="reciter">ক্বারি নির্বাচন</label>
    <select id="reciter">
      <option value="Alafasy_128kbps">মিশারি রাশিদ আল-আফাসি</option>
      <option value="Abdul_Basit_Murattal_192kbps">আবদুল বাসিত আবদুস সামাদ (মুরাত্তাল)</option>
      <option value="Husary_128kbps">মাহমুদ খলিল আল-হুসারি</option>
      <option value="Minshawy_Murattal_128kbps">মুহাম্মাদ সিদ্দিক আল-মিনশাওয়ি (মুরাত্তাল)</option>
      <option value="Abdurrahmaan_As-Sudais_192kbps">আবদুর রহমান আস-সুদাইস</option>
      <option value="Saood_ash-Shuraym_128kbps">সা‘ঊদ আশ-শুরাইম</option>
      <option value="Maher_AlMuaiqly_128kbps">মাহের আল-মুআইকিলি</option>
      <option value="Abu_Bakr_Ash-Shaatree_128kbps">আবু বকর আশ-শাতরি</option>
    </select>
    <p id="audio-current" class="muted" aria-live="polite">কোনো আয়াত চালু নেই</p>
    <audio id="quran-audio" controls preload="none">আপনার ব্রাউজার অডিও প্লেয়ার সমর্থন করে না।</audio>
    <div class="audio-actions">
      <button id="audio-prev" type="button">⏮ আগের আয়াত</button>
      <button id="audio-play" type="button">▶ চালান</button>
      <button id="audio-next" type="button">পরের আয়াত ⏭</button>
      <label for="audio-speed">গতি</label>
      <select id="audio-speed"><option value="0.75">০.৭৫×</option><option value="1" selected>১×</option><option value="1.25">১.২৫×</option><option value="1.5">১.৫×</option></select>
    </div>
    <p class="audio-note">অডিও সূত্র: EveryAyah.com। অডিও ফাইল ইন্টারনেট থেকে স্ট্রিম হবে; এই ধাপে ডাউনলোড বা অফলাইন অডিও যুক্ত হয়নি।</p>
  </section>
  <p id="reader-status" class="status" role="status" aria-live="polite">আরবি আয়াত ও বাংলা অনুবাদ লোড হচ্ছে…</p>
  <p id="tajweed-status" class="status" role="status" aria-live="polite" hidden></p>
  <section id="tajweed-legend" class="tajweed-legend panel" hidden>
    <strong>তাজবিদ রঙের নির্দেশিকা</strong>
    <span class="tj tj-gh">গুন্নাহ</span><span class="tj tj-q">কলকলা</span>
    <span class="tj tj-ik">ইখফা</span><span class="tj tj-iq">ইকলাব</span>
    <span class="tj tj-ig">ইদগাম বিগুন্নাহ</span><span class="tj tj-iw">ইদগাম বিলা গুন্নাহ</span>
    <span class="tj tj-mn">মাদ্দ</span><span class="tj tj-ham">হামযাতুল ওয়াসল/নীরব হরফ</span>
    <p class="muted">রঙগুলো শেখার সহায়ক মাত্র; সঠিক মাখরাজ ও তাজবিদের জন্য যোগ্য শিক্ষকের কাছে শিখুন।</p>
  </section>
  <section id="ayah-list" aria-label="কুরআনের আয়াত"></section>
  <section class="tafsir panel" aria-labelledby="tafsir-heading">
    <h2 id="tafsir-heading">তাফসির</h2>
    <p>নির্বাচিত বাংলা তাফসির থেকে আয়াতভিত্তিক ব্যাখ্যা পড়ুন।</p>
    <div class="tafsir-controls">
      <label for="tafsir-source">তাফসিরের উৎস</label>
      <select id="tafsir-source"><option value="">তালিকা লোড করতে চাপ দিন</option></select>
      <label for="tafsir-ayah">আয়াত নম্বর</label>
      <input id="tafsir-ayah" type="number" min="1" max={surah.ayahCount} value="1" />
      <button id="load-tafsir" type="button">তাফসির দেখুন</button>
    </div>
    <p id="tafsir-status" class="status" role="status" aria-live="polite">তাফসির পড়তে উৎস নির্বাচন করে দেখুন।</p>
    <article id="tafsir-result" class="tafsir-result" aria-live="polite"></article>
    <p class="source-note">তাফসিরকারের ব্যাখ্যা মূল কুরআনের পাঠ ও অনুবাদ থেকে পৃথক। মতভেদপূর্ণ বিষয়ে নির্ভরযোগ্য আলেমের পরামর্শ নিন।</p>
  </section>
  <nav class="surah-pager" aria-label="সূরা নেভিগেশন">
    {surah.number > 1 && <a href={`/quran/surah/${surahs[surah.number - 2].slug}/`}>← আগের সূরা</a>}
    {surah.number < 114 && <a href={`/quran/surah/${surahs[surah.number].slug}/`}>পরের সূরা →</a>}
  </nav>
  <p class="source-note">ডেটা উৎস: Quran.com API v4; অনুবাদের বিকল্প উৎস হিসেবে alquran.cloud। অনুবাদ ও আরবি পাঠ প্রদর্শনের আগে নিজ দায়িত্বে নির্ভরযোগ্য মুদ্রিত মুসহাফ/অনুবাদের সঙ্গে মিলিয়ে নিন। নেটওয়ার্ক সংযোগ প্রয়োজন; এই পর্যায়ে পূর্ণ অফলাইন পাঠ বা অডিও যুক্ত হয়নি।</p>
</BaseLayout>

<script define:vars={{ surahNumber: surah.number, ayahCount: surah.ayahCount }}>
  const api = 'https://api.quran.com/api/v4';
  const fallback = 'https://api.alquran.cloud/v1';
  const list = document.querySelector('#ayah-list');
  const status = document.querySelector('#reader-status');
  const selector = document.querySelector('#translation');
  const storageKey = 'quran-reader-bookmarks-v1';
  const qariKey = 'quran-reader-qari-v1';
  const tafsirKey = 'quran-reader-tafsir-v1';
  const tafsirSource = document.querySelector('#tafsir-source');
  const tafsirAyah = document.querySelector('#tafsir-ayah');
  const tafsirStatus = document.querySelector('#tafsir-status');
  const tafsirResult = document.querySelector('#tafsir-result');
  const tajweedStatus = document.querySelector('#tajweed-status');
  const tajweedLegend = document.querySelector('#tajweed-legend');
  const tajweedButton = document.querySelector('#toggle-tajweed');
  let tajweedEnabled = false;
  let tajweedVerses = null;
  const qaris = [
    ['Alafasy_128kbps','মিশারি রাশিদ আল-আফাসি'],
    ['Abdul_Basit_Murattal_192kbps','আবদুল বাসিত আবদুস সামাদ (মুরাত্তাল)'],
    ['Husary_128kbps','মাহমুদ খলিল আল-হুসারি'],
    ['Minshawy_Murattal_128kbps','মুহাম্মাদ সিদ্দিক আল-মিনশাওয়ি (মুরাত্তাল)'],
    ['Abdurrahmaan_As-Sudais_192kbps','আবদুর রহমান আস-সুদাইস'],
    ['Saood_ash-Shuraym_128kbps','সা‘ঊদ আশ-শুরাইম'],
    ['Maher_AlMuaiqly_128kbps','মাহের আল-মুআইকিলি'],
    ['Abu_Bakr_Ash-Shaatree_128kbps','আবু বকর আশ-শাতরি']
  ];
  const audio = document.querySelector('#quran-audio');
  const reciter = document.querySelector('#reciter');
  const audioCurrent = document.querySelector('#audio-current');
  let currentAyah = 0;
  let fontSize = 34;
  try {
    const savedQari = localStorage.getItem(qariKey);
    if (savedQari && qaris.some(item => item[0] === savedQari)) reciter.value = savedQari;
  } catch {}
  const bn = (value) => String(value).replace(/\\d/g, d => '০১২৩৪৫৬৭৮৯'[Number(d)]);
  const safeGet = async (url) => {
    const response = await fetch(url);
    if (!response.ok) throw new Error('সার্ভার সাড়া দেয়নি (HTTP ' + response.status + ')');
    return response.json();
  };
  const bookmarks = () => {
    try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); }
    catch { return []; }
  };
  const setStatus = (message) => { status.textContent = message; };
  const appendSafeTafsir = (markup, target) => {
    const parsed = new DOMParser().parseFromString('<div>' + String(markup || '') + '</div>', 'text/html');
    const allowed = new Set(['P','BR','STRONG','B','EM','I','UL','OL','LI','H3','H4','BLOCKQUOTE']);
    const copy = (source, parent) => {
      for (const node of source.childNodes) {
        if (node.nodeType === Node.TEXT_NODE) parent.append(document.createTextNode(node.textContent || ''));
        else if (node.nodeType === Node.ELEMENT_NODE) {
          if (allowed.has(node.tagName)) {
            const safe = document.createElement(node.tagName.toLowerCase());
            copy(node, safe);
            parent.append(safe);
          } else copy(node, parent);
        }
      }
    };
    copy(parsed.body.firstElementChild || parsed.body, target);
  };
  async function loadTafsirSources() {
    tafsirStatus.textContent = 'বাংলা তাফসিরের তালিকা আনা হচ্ছে…';
    try {
      const data = await safeGet(api + '/resources/tafsirs');
      const sources = (data.tafsirs || []).filter(item =>
        /bengali|bangla/i.test(String(item.language_name || ''))
      );
      if (!sources.length) throw new Error('বাংলা তাফসিরের তালিকা পাওয়া যায়নি।');
      tafsirSource.replaceChildren();
      sources.forEach(item => {
        const option = document.createElement('option');
        option.value = String(item.id);
        option.textContent = (item.name || 'বাংলা তাফসির') + (item.author_name ? ' — ' + item.author_name : '');
        tafsirSource.append(option);
      });
      const saved = localStorage.getItem(tafsirKey);
      if (saved && sources.some(item => String(item.id) === saved)) tafsirSource.value = saved;
      tafsirStatus.textContent = 'বাংলা তাফসিরের ' + bn(sources.length) + 'টি উৎস পাওয়া গেছে।';
      return true;
    } catch (error) {
      tafsirStatus.textContent = 'তাফসিরের তালিকা লোড হয়নি: ' + (error?.message || 'অজানা সমস্যা');
      return false;
    }
  }
  async function showTafsir() {
    const ayah = Number(tafsirAyah.value);
    if (!tafsirSource.value) {
      if (!await loadTafsirSources()) return;
    }
    if (!Number.isInteger(ayah) || ayah < 1 || ayah > ayahCount) {
      tafsirStatus.textContent = 'আয়াত নম্বর ১ থেকে ' + bn(ayahCount) + '-এর মধ্যে দিন।';
      return;
    }
    tafsirStatus.textContent = 'তাফসির লোড হচ্ছে…';
    tafsirResult.replaceChildren();
    try {
      const sourceId = tafsirSource.value;
      const data = await safeGet(api + '/tafsirs/' + encodeURIComponent(sourceId) + '/by_ayah/' + surahNumber + ':' + ayah);
      const text = data.tafsir?.text;
      if (!text) throw new Error('এই আয়াতের জন্য নির্বাচিত উৎসে তাফসির পাওয়া যায়নি।');
      const heading = document.createElement('h3');
      heading.textContent = 'সূরা ' + bn(surahNumber) + ', আয়াত ' + bn(ayah);
      const body = document.createElement('div');
      body.className = 'tafsir-text';
      appendSafeTafsir(text, body);
      if (!body.textContent.trim()) throw new Error('তাফসিরের পাঠ খালি এসেছে।');
      tafsirResult.append(heading, body);
      localStorage.setItem(tafsirKey, sourceId);
      tafsirStatus.textContent = 'তাফসির লোড হয়েছে।';
    } catch (error) {
      tafsirStatus.textContent = 'তাফসির লোড হয়নি: ' + (error?.message || 'অজানা সমস্যা');
    }
  }
  const tajweedClass = {
    ham_wasl:'ham', hamzat_wasl:'ham', slnt:'ham', silent:'ham',
    laam_shamsiyah:'ham', lam_shamsiyyah:'ham',
    madda_normal:'mn', madda_permissible:'mp', madda_necessary:'mnec', madda_obligatory:'mo',
    qalaqah:'q', qlq:'q', qalqalah:'q', ikhfa:'ik', ikhf:'ik',
    ikhfa_shafawi:'iks', ikhf_shfw:'iks', iqlab:'iq', iqlb:'iq',
    idgham_ghunnah:'ig', idgh_ghn:'ig', idgham_wo_ghunnah:'iw', idgh_w_ghn:'iw',
    idgham_shafawi:'is', idghm_shfw:'is', idgham_mutajanisayn:'im', idgh_mus:'im',
    idgham_mutaqaribayn:'im', ghunnah:'gh', ghn:'gh'
  };
  const normalizeArabic = (value) => String(value || '').normalize('NFKC').replace(/[\s۞۩۝ـ]/g, '');
  function tajweedFragment(markup, expectedText) {
    const parsed = new DOMParser().parseFromString('<div>' + markup + '</div>', 'text/html');
    const root = parsed.body.firstElementChild;
    if (!root || normalizeArabic(root.textContent) !== normalizeArabic(expectedText)) return null;
    const fragment = document.createDocumentFragment();
    const copy = (source, target) => {
      for (const node of source.childNodes) {
        if (node.nodeType === Node.TEXT_NODE) target.append(document.createTextNode(node.textContent || ''));
        else if (node.nodeType === Node.ELEMENT_NODE) {
          if (node.tagName === 'SUP' || (node.getAttribute('class') || '').trim() === 'end') continue;
          const span = document.createElement('span');
          const rawClass = (node.getAttribute('class') || '').trim().replace(/[^a-z_]/g, '');
          const mapped = tajweedClass[rawClass];
          if (mapped) span.className = 'tj tj-' + mapped;
          copy(node, span);
          target.append(span);
        }
      }
    };
    copy(root, fragment);
    return fragment;
  }
  async function loadTajweed() {
    const response = await safeGet(api + '/quran/verses/uthmani_tajweed?chapter_number=' + surahNumber);
    const verses = response.verses || [];
    if (verses.length !== ayahCount || verses.some(verse => typeof verse.text_uthmani_tajweed !== 'string')) {
      throw new Error('তাজবিদ ডেটার আয়াত সংখ্যা বা গঠন মেটাডেটার সঙ্গে মেলেনি।');
    }
    tajweedVerses = verses.map(verse => verse.text_uthmani_tajweed);
  }
  function applyTajweed() {
    document.querySelectorAll('.ayah').forEach((article, index) => {
      const arabic = article.querySelector('.ayah-arabic');
      if (!arabic) return;
      if (!tajweedEnabled || !tajweedVerses) { arabic.textContent = arabic.dataset.plain || arabic.textContent; return; }
      const fragment = tajweedFragment(tajweedVerses[index] || '', arabic.dataset.plain || '');
      if (fragment) arabic.replaceChildren(fragment);
      else arabic.textContent = arabic.dataset.plain || '';
    });
  }
  const addAyah = (number, arabic, translation) => {
    const article = document.createElement('article');
    article.className = 'ayah panel';
    article.id = 'ayah-' + number;
    const heading = document.createElement('div');
    heading.className = 'ayah-heading';
    heading.textContent = 'আয়াত ' + bn(number);
    const ar = document.createElement('p');
    ar.className = 'ayah-arabic';
    ar.lang = 'ar'; ar.dir = 'rtl'; ar.textContent = arabic;
    ar.dataset.plain = arabic;
    ar.style.fontSize = fontSize + 'px';
    const tr = document.createElement('p');
    tr.className = 'ayah-translation'; tr.textContent = translation || 'এই আয়াতের অনুবাদ পাওয়া যায়নি।';
    const actions = document.createElement('div'); actions.className = 'ayah-actions';
    const mark = document.createElement('button'); mark.type = 'button';
    const key = surahNumber + ':' + number;
    const refreshMark = () => { mark.textContent = bookmarks().includes(key) ? '★ বুকমার্ক করা' : '☆ বুকমার্ক'; };
    refreshMark();
    mark.addEventListener('click', () => {
      const saved = bookmarks();
      const next = saved.includes(key) ? saved.filter(item => item !== key) : [...saved, key];
      try { localStorage.setItem(storageKey, JSON.stringify(next)); refreshMark(); }
      catch { setStatus('বুকমার্ক সংরক্ষণ করা যায়নি—ব্রাউজারের স্টোরেজ পরীক্ষা করুন।'); }
    });
    const listen = document.createElement('button'); listen.type = 'button'; listen.textContent = '▶ শুনুন';
    listen.addEventListener('click', () => playAyah(number));
    const copy = document.createElement('button'); copy.type = 'button'; copy.textContent = 'আয়াত কপি';
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(arabic + '\\n' + tr.textContent); setStatus('আয়াত কপি হয়েছে।'); }
      catch { setStatus('কপি করা যায়নি। ব্রাউজারের অনুমতি পরীক্ষা করুন।'); }
    });
    actions.append(listen, mark, copy);
    article.append(heading, ar, tr, actions);
    list.append(article);
  };
  function audioUrl(number) {
    const surah = String(surahNumber).padStart(3, '0');
    const ayah = String(number).padStart(3, '0');
    return 'https://everyayah.com/data/' + encodeURIComponent(reciter.value) + '/' + surah + ayah + '.mp3';
  }
  function playAyah(number) {
    if (number < 1 || number > ayahCount) return;
    currentAyah = number;
    audioCurrent.textContent = 'সূরা ' + bn(surahNumber) + ', আয়াত ' + bn(number) + ' — ' + (qaris.find(item => item[0] === reciter.value)?.[1] || 'নির্বাচিত ক্বারি');
    audio.src = audioUrl(number);
    audio.load();
    audio.play().then(() => {
      document.querySelectorAll('.ayah.playing').forEach(node => node.classList.remove('playing'));
      document.querySelector('#ayah-' + number)?.classList.add('playing');
    }).catch(() => {
      setStatus('অডিও চালু করা যায়নি। ইন্টারনেট সংযোগ বা নির্বাচিত ক্বারির ফাইলের প্রাপ্যতা পরীক্ষা করুন।');
    });
  }
  audio.addEventListener('ended', () => {
    document.querySelector('#ayah-' + currentAyah)?.classList.remove('playing');
    if (currentAyah < ayahCount) playAyah(currentAyah + 1);
    else audioCurrent.textContent = 'এই সূরার তিলাওয়াত শেষ হয়েছে।';
  });
  audio.addEventListener('error', () => {
    setStatus('এই আয়াতের অডিও পাওয়া যায়নি। অন্য ক্বারি নির্বাচন করে চেষ্টা করুন।');
    document.querySelector('#ayah-' + currentAyah)?.classList.remove('playing');
  });
  document.querySelector('#audio-play').addEventListener('click', () => {
    if (!currentAyah) playAyah(1);
    else if (audio.paused) audio.play().catch(() => setStatus('অডিও চালু করা যায়নি।'));
    else audio.pause();
  });
  document.querySelector('#audio-prev').addEventListener('click', () => playAyah(Math.max(1, (currentAyah || 1) - 1)));
  document.querySelector('#audio-next').addEventListener('click', () => playAyah(Math.min(ayahCount, (currentAyah || 0) + 1)));
  document.querySelector('#audio-speed').addEventListener('change', event => { audio.playbackRate = Number(event.target.value); });
  reciter.addEventListener('change', () => {
    try { localStorage.setItem(qariKey, reciter.value); } catch {}
    if (currentAyah) playAyah(currentAyah);
  });
  async function load() {
    list.replaceChildren();
    setStatus('আয়াত ও অনুবাদ আনা হচ্ছে…');
    try {
      const requestedTranslation = selector.value;
      const translationList = await safeGet(api + '/resources/translations').catch(() => ({ translations: [] }));
      const bengali = (translationList.translations || []).filter(item =>
        String(item.language_name || '').toLowerCase().includes('bengali') ||
        String(item.language_name || '').toLowerCase().includes('bangla')
      );
      bengali.sort((a,b) => Number(/muhiuddin/i.test((b.author || '') + ' ' + (b.name || ''))) - Number(/muhiuddin/i.test((a.author || '') + ' ' + (a.name || ''))));
      selector.replaceChildren();
      const auto = document.createElement('option'); auto.value = 'auto'; auto.textContent = 'স্বয়ংক্রিয় (প্রস্তাবিত)'; selector.append(auto);
      bengali.forEach(item => {
        const option = document.createElement('option');
        option.value = String(item.id); option.textContent = (item.name || 'বাংলা অনুবাদ') + (item.author ? ' — ' + item.author : '');
        selector.append(option);
      });
      if ([...selector.options].some(option => option.value === requestedTranslation)) selector.value = requestedTranslation;
      const [arabicResult, chosenTranslation] = await Promise.all([
        safeGet(api + '/quran/verses/uthmani?chapter_number=' + surahNumber),
        (async () => {
          const selected = selector.value === 'auto' ? (bengali[0]?.id) : Number(selector.value);
          if (selected) {
            try { return await safeGet(api + '/quran/translations/' + selected + '?chapter_number=' + surahNumber); }
            catch {}
          }
          return safeGet(fallback + '/surah/' + surahNumber + '/bn.bengali');
        })()
      ]);
      const arabicVerses = arabicResult.verses || [];
      const translated = chosenTranslation.translations
        ? chosenTranslation.translations.map(item => String(item.text || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').trim())
        : (chosenTranslation.data?.ayahs || []).map(item => item.text || '');
      if (arabicVerses.length !== ayahCount) throw new Error('আরবি আয়াত সংখ্যা মেটাডেটার সঙ্গে মেলেনি; নিরাপত্তার জন্য পাঠ দেখানো হয়নি।');
      if (translated.length !== ayahCount) throw new Error('বাংলা অনুবাদের আয়াত সংখ্যা মেলেনি; নিরাপত্তার জন্য পাঠ দেখানো হয়নি।');
      tajweedVerses = null;
      tajweedEnabled = false;
      tajweedButton.setAttribute('aria-pressed', 'false');
      tajweedButton.textContent = 'তাজবিদের রং দেখান';
      tajweedLegend.hidden = true;
      tajweedStatus.hidden = true;
      arabicVerses.forEach((verse, index) => addAyah(index + 1, verse.text_uthmani, translated[index]));
      setStatus('মোট ' + bn(ayahCount) + 'টি আয়াত লোড হয়েছে। অনুবাদ: ' + (bengali.find(x => String(x.id) === String(selector.value))?.name || 'বাংলা বিকল্প উৎস'));
    } catch (error) {
      setStatus('পাঠ লোড করা যায়নি: ' + (error?.message || 'অজানা সমস্যা') + '। ইন্টারনেট সংযোগ দিয়ে আবার চেষ্টা করুন।');
    }
  }
  document.querySelector('#load-reader').addEventListener('click', load);
  selector.addEventListener('change', load);
  tafsirSource.addEventListener('focus', () => { if (!tafsirSource.options.length || !tafsirSource.value) loadTafsirSources(); }, { once: true });
  document.querySelector('#load-tafsir').addEventListener('click', async () => {
    if (!tafsirSource.value) {
      if (!await loadTafsirSources()) return;
    }
    showTafsir();
  });
  tafsirSource.addEventListener('change', () => {
    try { localStorage.setItem(tafsirKey, tafsirSource.value); } catch {}
    if (tafsirResult.childNodes.length) showTafsir();
  });
  tajweedButton.addEventListener('click', async () => {
    if (tajweedEnabled) {
      tajweedEnabled = false;
      applyTajweed();
      tajweedLegend.hidden = true;
      tajweedStatus.hidden = true;
      tajweedButton.setAttribute('aria-pressed', 'false');
      tajweedButton.textContent = 'তাজবিদের রং দেখান';
      return;
    }
    tajweedStatus.hidden = false;
    tajweedStatus.textContent = 'তাজবিদের ডেটা লোড হচ্ছে…';
    try {
      if (!tajweedVerses) await loadTajweed();
      tajweedEnabled = true;
      applyTajweed();
      tajweedLegend.hidden = false;
      tajweedStatus.textContent = 'তাজবিদের রং দেখানো হচ্ছে। যেসব আয়াতের টেক্সট হুবহু মেলেনি, সেগুলো সাধারণ আরবি লেখায় রাখা হয়েছে।';
      tajweedButton.setAttribute('aria-pressed', 'true');
      tajweedButton.textContent = 'তাজবিদের রং বন্ধ করুন';
    } catch (error) {
      tajweedStatus.textContent = 'তাজবিদের ডেটা লোড হয়নি: ' + (error?.message || 'অজানা সমস্যা');
      tajweedEnabled = false;
    }
  });
  document.querySelector('#font-up').addEventListener('click', () => {
    fontSize = Math.min(54, fontSize + 2);
    document.querySelectorAll('.ayah-arabic').forEach(node => node.style.fontSize = fontSize + 'px');
  });
  document.querySelector('#font-down').addEventListener('click', () => {
    fontSize = Math.max(24, fontSize - 2);
    document.querySelectorAll('.ayah-arabic').forEach(node => node.style.fontSize = fontSize + 'px');
  });
  load();
</script>

<style>
  .tafsir{margin:18px 0;padding:16px}
  .tafsir h2{margin-top:0}
  .tafsir-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
  .tafsir-controls select,.tafsir-controls input{max-width:100%;padding:8px;border:1px solid #cfc7b5;border-radius:8px}
  .tafsir-controls select{min-width:min(260px,100%)}
  .tafsir-controls button{border:1px solid #0b5d45;background:#0b5d45;color:white;border-radius:9px;padding:8px 14px;cursor:pointer}
  .tafsir-result{line-height:1.9}
  .tafsir-text{overflow-wrap:anywhere}
  .tafsir-text p{margin:10px 0}
  .audio-player{margin:16px 0}
  .tajweed-legend{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px;margin:12px 0}
  .tajweed-legend strong{width:100%}
  .tajweed-legend .muted{width:100%;margin:4px 0 0;font-size:.88rem}
  .tj{font-weight:600}
  .tj-gh{color:#8b3f9f}.tj-q{color:#b45309}.tj-ik{color:#087f5b}.tj-iq{color:#b42318}
  .tj-ig{color:#1769aa}.tj-iw{color:#6b4fbb}.tj-mn{color:#a16207}.tj-mp{color:#0f766e}
  .tj-mnec{color:#be123c;font-weight:800}.tj-mo{color:#0369a1}.tj-ham{color:#64748b}.tj-iks{color:#9333ea}
  .tj-is{color:#0e7490}.tj-im{color:#4d7c0f}
  .audio-player h2{margin-top:0}
  .audio-player>select{display:block;max-width:100%;margin:6px 0 12px;padding:8px;border:1px solid #cfc7b5;border-radius:8px}
  .audio-player audio{display:block;width:100%;margin:10px 0}
  .audio-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .audio-actions button{border:1px solid #0b5d45;background:#fff;color:#0b5d45;border-radius:9px;padding:7px 12px;cursor:pointer}
  .audio-actions select{padding:7px;border:1px solid #cfc7b5;border-radius:8px}
  .audio-note{font-size:.88rem;color:#5d6b64}
  .ayah.playing{border-color:#0b5d45;box-shadow:0 0 0 2px rgba(11,93,69,.12)}
  .reader-tools{display:flex;align-items:center;flex-wrap:wrap;gap:10px;background:#fff;border:1px solid #e4ddc9;border-radius:14px;padding:12px;margin:16px 0}
  .reader-tools button,.ayah-actions button{border:1px solid #0b5d45;background:#fff;color:#0b5d45;border-radius:9px;padding:7px 12px;cursor:pointer}
  .reader-tools select{max-width:min(100%,360px);padding:8px;border:1px solid #cfc7b5;border-radius:8px}
  .status{padding:10px 14px;background:#f4ead0;border-radius:10px}
  .ayah.panel{padding:18px;margin:12px 0}
  .ayah-heading{font-weight:700;color:#0b5d45;border-bottom:1px solid #e4ddc9;padding-bottom:8px}
  .ayah-arabic{font-family:"Amiri Quran","Noto Naskh Arabic","Traditional Arabic",serif;direction:rtl;text-align:right;line-height:2.2;overflow-wrap:anywhere;margin:14px 0}
  .ayah-translation{font-size:1.05rem;line-height:2;color:#293b32}
  .ayah-actions{display:flex;gap:8px;flex-wrap:wrap}
  .surah-pager{display:flex;justify-content:space-between;gap:12px;margin:18px 0}
  .surah-pager a{padding:10px 14px;border:1px solid #e4ddc9;border-radius:10px;text-decoration:none}
  .source-note{font-size:.9rem;color:#5d6b64;border-top:1px solid #e4ddc9;padding-top:14px}
  @media(max-width:560px){.reader-tools{align-items:stretch}.reader-tools select{flex:1;min-width:100%}}
</style>
